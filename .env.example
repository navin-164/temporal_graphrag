# ==============================================================================
# Temporal Hybrid GraphRAG — environment variables template
#
# Copy this file to `.env` in the same folder, then fill in real values there.
# `.env` is already in .gitignore — never commit it.
# This file (.env.example) IS meant to be committed — placeholders only,
# nothing secret.
#
#   copy .env.example .env      (Windows cmd)
#
# Sections are grouped by when you'll actually need them. Most of this is
# irrelevant until later weeks — don't feel like you need to fill in the
# whole file today.
# ==============================================================================

# ------------------------------------------------------------------------------
# NEEDED NOW — Week 2-3
# ------------------------------------------------------------------------------

# Semantic Scholar — used by 02_enrich_citation_graph.py
# Free key: https://www.semanticscholar.org/product/api
S2_API_KEY=your-semantic-scholar-key-here

# GROBID — the lightweight CRF Docker container for this week's parser.
# Matches: docker run --rm --init -p 8070:8070 grobid/grobid:<pinned-tag>-crf
GROBID_URL=http://localhost:8070

ENVIRONMENT=development           # development | production — gates debug behavior
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# NEEDED SOON — Weeks 7-8 (knowledge graph)
# ------------------------------------------------------------------------------

# Neo4j — matches your local Neo4j Desktop DBMS (neo4j://127.0.0.1:7687 from
# your screenshot). Start the DBMS and create a database first — there's no
# default password, use whatever you set when creating it.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# NEEDED FOR AGENTS — Weeks 12-14
# ------------------------------------------------------------------------------

# Groq — primary LLM: fast, mostly-text agent calls (Planner, Retrieval,
# Reasoning, Verification, Summarization, Trend, Evaluation).
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
# ^ verify this is still hosted at https://console.groq.com/docs/models when
#   we actually build llm/groq_provider.py — Groq's free lineup shifts.

# Gemini — routed: Multimodal Understanding agent + prompts that would
# overflow Groq's per-minute token budget.
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
# ^ deliberately NOT gemini-2.5-flash: Google is shutting the entire 2.5
#   line down on the Gemini Developer API in October 2026 — mid-semester.
#   3.6 Flash is the current GA (stable, not preview) Flash-tier model.

# Token budget (tokens) above which llm/factory.py routes to Gemini instead
# of Groq. Starting guess — we'll tune this once we see real prompt sizes.
LLM_GROQ_TOKEN_OVERFLOW_THRESHOLD=5000

# ------------------------------------------------------------------------------
# NEEDED LATER — Week 14+ (FastAPI + Streamlit)
# ------------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_API_BASE_URL=http://localhost:8000

# ==============================================================================
# Not here: Dynamic Update Module and Feedback/RLHF config — both Deferred
# per your Scope Map, so there's nothing to configure yet.
# ==============================================================================
